# --- caches / junk ---
__pycache__/
*.pyc
.DS_Store
.env
*.log

# --- bulk analysis outputs: regenerated, never committed ---
**/results/
**/plots/
*.pkl
*.png

# --- collector data stores: tens of GB, live outside git ---
# Phases 1-2 collect fresh data; historical stores transfer separately.
waves_data/
ladder/data/
data_smoke/

# wti_arb store (large / purchased data).
# FINDINGS_*.md, summary.csv and manifest snapshots are deliberately KEPT.
wti_arb/data/parquet/kalshi_candles/
wti_arb/data/parquet/kalshi_markets/
wti_arb/data/parquet/kalshi_events/
wti_arb/data/raw/
wti_arb/data/manifest.jsonl
wti_arb/data/manifest.v1.json
wti_arb/data/probe.json
wti_arb/data_cme/raw/
wti_arb/data_cme/parquet/
wti_arb/data_cme/db.log
wti_arb/synth/results/*.pkl

# --- marketmaking phase 1 (added 2026-10-18) ---
# Shadow-run data and logs. Full depth on 1,240 markets for 14 days; code only
# in git, per the same rule that keeps ladder/data and waves_data out.
.venv/
marketmaking/data/
marketmaking/logs/
marketmaking/KILL

# LIP raw sweeps: ~50MB of program records each, regenerable via
# marketmaking/coverage/fetch_lip.py. The per-series summary and the
# pagination diagnostics in coverage_meta.json are committed instead.
marketmaking/coverage/lip_*.json
